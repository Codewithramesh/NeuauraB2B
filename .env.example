# All paths resolve from the repository root. Never commit .env.
NEUAURA_DATA_DIR=local-data
# Leave blank for SQLite in DATA_DIR. PostgreSQL requires psycopg separately.
NEUAURA_DATABASE_URL=
NEUAURA_MAX_UPLOAD_MB=50
NEUAURA_MAX_DURATION_SECONDS=600
NEUAURA_RETAIN_AUDIO=false
NEUAURA_RETENTION_DAYS=30
NEUAURA_LANGUAGE=en
NEUAURA_WHISPER_MODEL_PATH=models/faster-whisper-tiny.en
NEUAURA_WHISPER_COMPUTE_TYPE=int8
NEUAURA_EXTRACTION_PROVIDER=ollama
NEUAURA_LLM_BASE_URL=http://127.0.0.1:11434
NEUAURA_LLM_MODEL=qwen3:4b
# Remote processing is disabled unless BOTH of these are deliberately configured.
NEUAURA_ALLOW_CLOUD=false
NEUAURA_LLM_API_KEY=
NEUAURA_SECURE_COOKIES=false
NEUAURA_WORKER_ENABLED=true
# For private HTTPS phone testing, add the exact external hostname and enable Secure cookies.
NEUAURA_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]

# Fast structured extraction on this 8 GB Mac.
NEUAURA_LLM_THINK=false
NEUAURA_LLM_CONTEXT_LENGTH=8192
